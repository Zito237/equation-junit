<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vv.inf563</groupId>
    <artifactId>equation-second-degre-junit</artifactId>
    <version>2.0</version>
    <name>Équation du second degré : pairwise, réflexivité et oracles (JUnit 5)</name>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <!-- solveur testé, connu des tests uniquement par ce nom (réflexivité) -->
        <solveur.classe>equation.SolveurRobuste</solveur.classe>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- pour vv.outils.TableauDetection, qui lance la suite contre chaque solveur -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- un échec = son message et la ligne du test, sans les 40 lignes internes de JUnit -->
                    <trimStackTrace>true</trimStackTrace>
                    <systemPropertyVariables>
                        <solveur.classe>${solveur.classe}</solveur.classe>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- mvn test-compile exec:java : tableau « détecte / ne détecte pas » sur les 3 solveurs -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>vv.outils.TableauDetection</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
            <plugin>
                <!-- Couverture de code (séance 5 : JaCoCo) : mvn verify -> target/site/jacoco/index.html.
                     check : quality gate sur le solveur testé (${solveur.classe}) : 80 % des branches, 90 % des lignes. -->
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>rapport</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>${solveur.classe}</include></includes>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Test de mutation (séance 5 : PIT) :
                     mvn test-compile org.pitest:pitest-maven:mutationCoverage -> target/pit-reports/index.html
                     Cibles : le solveur robuste et ses classes d'appui. Naïf et Cours sont des mutants « par conception »
                     déjà évalués par TableauDetection. -->
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>1.15.3</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>equation.SolveurRobuste</param>
                        <param>equation.Etendu</param>
                        <param>equation.Coefficient</param>
                    </targetClasses>
                    <targetTests>
                        <param>vv.tests.*</param>
                    </targetTests>
                    <mutators><mutator>DEFAULTS</mutator></mutators>
                    <outputFormats><param>HTML</param><param>XML</param><param>CSV</param></outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>4</threads>
                    <!-- les rapports console (verdicts, journal) n'ont pas d'intérêt pendant la mutation -->
                    <jvmArgs><jvmArg>-Drapport.silencieux=true</jvmArg></jvmArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pnaif   /   mvn test -Pcours   /   mvn test (robuste par défaut) -->
        <profile>
            <id>naif</id>
            <properties>
                <solveur.classe>equation.SolveurNaif</solveur.classe>
            </properties>
        </profile>
        <profile>
            <id>cours</id>
            <properties>
                <solveur.classe>equation.SolveurStableCours</solveur.classe>
            </properties>
        </profile>
    </profiles>
</project>
